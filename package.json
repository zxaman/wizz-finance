{
  "name": "@wizz/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Wizz Finance (Paygate) Nx Angular 21 Monorepo with reusable Design System, Signal Stores, and Cross-Border Remittance Applications",
  "scripts": {
    "nx": "nx",
    "start": "nx serve wizz-finance",
    "serve:wizz-finance": "nx serve wizz-finance",
    "serve:partner": "nx serve wizz-partner-portal --port 4300",
    "build": "nx build wizz-finance",
    "build:partner": "nx build wizz-partner-portal",
    "build:all": "nx run-many -t build",
    "watch": "nx build wizz-finance --watch --configuration development",
    "test": "nx run-many -t test",
    "projects": "nx show projects",
    "graph": "nx graph"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.11",
    "@lucide/angular": "^1.72.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular-devkit/core": "^21.2.11",
    "@angular-devkit/schematics": "^21.2.11",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@nx/angular": "^24.0.6",
    "@nx/js": "^24.0.6",
    "@nx/workspace": "^24.0.6",
    "@schematics/angular": "^21.2.11",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "nx": "^24.0.6",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
